# LLM Provider selection (default: openai, options: openai, deepseek)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-3.5-turbo

# DeepSeek Configuration (required if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database (default: mongodb://localhost:27017/resume)
MONGO_URI=mongodb://localhost:27017/resume
